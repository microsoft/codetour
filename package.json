{
  "name": "codetour",
  "displayName": "CodeTour IA",
  "description": "Record and playback guided tours of codebases, with AI-generated project and changes tours, directly within the editor",
  "publisher": "maurice30120",
  "version": "0.1.2",
  "packageManager": "npm@12.0.1",
  "volta": {
    "node": "24.18.0",
    "npm": "12.0.1"
  },
  "author": {
    "name": "Microsoft Corporation"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maurice30120/codetour"
  },
  "bugs": {
    "url": "https://github.com/maurice30120/codetour/issues"
  },
  "homepage": "https://github.com/maurice30120/codetour#readme",
  "license": "MIT",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "Collaboration",
    "Sharing"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onNotebookEditor:codetour"
  ],
  "main": "./dist/extension-node.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "codetour.tour-generator",
        "label": "CodeTour Tour Generator"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "CodeTour",
      "properties": {
        "codetour.promptForWorkspaceTours": {
          "type": "boolean",
          "default": true,
          "description": "Specifies whether or not to display a notification when opening a workspace with tours for the first time."
        },
        "codetour.recordMode": {
          "type": "string",
          "enum": [
            "lineNumber",
            "pattern"
          ],
          "default": "lineNumber",
          "description": "Specifies how the tour recorder will behave when capturing a new step."
        },
        "codetour.showMarkers": {
          "type": "boolean",
          "default": true,
          "description": "Specifies whether or not to show tour markers in the editor gutter."
        },
        "codetour.commentPosition": {
          "type": "string",
          "enum": [
            "above",
            "below"
          ],
          "default": "above",
          "description": "Position tour comments above or below their code anchor during playback. Above keeps adjacent single-line C# attributes with the declaration. A first-line anchor displays below the first line."
        },
        "codetour.customTourDirectory": {
          "type": "string",
          "default": null,
          "description": "Specifies a custom location to use when discovering tours."
        }
      }
    },
    "commands": [
      {
        "command": "codetourIA.configureCodexMcp",
        "title": "Configure MCP for Codex",
        "category": "CodeTour IA"
      },
      {
        "command": "codetourIA.repairCodexMcp",
        "title": "Repair MCP Configuration for Codex",
        "category": "CodeTour IA"
      },
      {
        "command": "codetourIA.addContentStep",
        "title": "Add Tour Step",
        "category": "CodeTour IA"
      },
      {
        "command": "codetourIA.addDirectoryStep",
        "title": "Add CodeTour Step"
      },
      {
        "command": "codetourIA.addSelectionStep",
        "title": "Add CodeTour Step"
      },
      {
        "command": "codetourIA.addTourStep",
        "title": "Add Step to Tour"
      },
      {
        "command": "codetourIA.changeTourDescription",
        "title": "Change Description"
      },
      {
        "command": "codetourIA.changeTourRef",
        "title": "Change Git Ref"
      },
      {
        "command": "codetourIA.changeTourStepLine",
        "title": "Change Line"
      },
      {
        "command": "codetourIA.changeTourStepTitle",
        "title": "Change Title"
      },
      {
        "command": "codetourIA.changeTourStepIcon",
        "title": "Change Icon"
      },
      {
        "command": "codetourIA.changeTourTitle",
        "title": "Change Title"
      },
      {
        "command": "codetourIA.resetProgress",
        "title": "Reset Progress",
        "category": "CodeTour IA"
      },
      {
        "command": "codetourIA.resetTourProgress",
        "title": "Reset Progress"
      },
      {
        "command": "codetourIA.deleteTourStep",
        "title": "Delete Step"
      },
      {
        "command": "codetourIA.deleteTour",
        "title": "Delete Tour"
      },
      {
        "command": "codetourIA.editTourAtStep",
        "title": "Edit Step"
      },
      {
        "command": "codetourIA.editTour",
        "title": "Edit Tour",
        "category": "CodeTour IA",
        "icon": "$(edit)"
      },
      {
        "command": "codetourIA.endTour",
        "title": "End Tour",
        "category": "CodeTour IA",
        "icon": "$(primitive-square)"
      },
      {
        "command": "codetourIA.exportTour",
        "title": "Export Tour..."
      },
      {
        "command": "codetourIA.hideMarkers",
        "title": "Hide Tour Markers",
        "category": "CodeTour IA",
        "icon": "$(eye-closed)"
      },
      {
        "command": "codetourIA.makeTourPrimary",
        "title": "Make Primary"
      },
      {
        "command": "codetourIA.moveTourStepForward",
        "title": "Move Down",
        "icon": "$(arrow-down)"
      },
      {
        "command": "codetourIA.moveTourStepBack",
        "title": "Move Up",
        "icon": "$(arrow-up)"
      },
      {
        "command": "codetourIA.nextTourStep",
        "title": "Next",
        "icon": "$(arrow-right)"
      },
      {
        "command": "codetourIA.openTourFile",
        "title": "Open Tour File...",
        "icon": "$(folder-opened)",
        "category": "CodeTour IA"
      },
      {
        "command": "codetourIA.openTourUrl",
        "title": "Open Tour URL...",
        "category": "CodeTour IA"
      },
      {
        "command": "codetourIA.previewTour",
        "title": "Preview Tour",
        "icon": "$(preview)"
      },
      {
        "command": "codetourIA.previousTourStep",
        "title": "Previous",
        "icon": "$(arrow-left)"
      },
      {
        "command": "codetourIA.recordTour",
        "title": "Record Tour",
        "category": "CodeTour IA",
        "icon": "$(add)"
      },
      {
        "command": "codetourIA.resumeTour",
        "title": "Resume Tour",
        "category": "CodeTour IA"
      },
      {
        "command": "codetourIA.saveTourStep",
        "title": "Save Step",
        "enablement": "codetour:isEditing || !commentIsEmpty",
        "category": "CodeTour IA"
      },
      {
        "command": "codetourIA.showMarkers",
        "title": "Show Tour Markers",
        "category": "CodeTour IA",
        "icon": "$(eye)"
      },
      {
        "command": "codetourIA.showStepDescription",
        "title": "Show Expanded Description",
        "category": "CodeTour IA",
        "icon": "$(open-preview)"
      },
      {
        "command": "codetourIA.startTour",
        "title": "Start Tour",
        "category": "CodeTour IA",
        "icon": "$(play)"
      },
      {
        "command": "codetourIA.unmakeTourPrimary",
        "title": "Unmake Primary"
      },
      {
        "command": "codetourIA.viewNotebook",
        "title": "View Notebook",
        "category": "CodeTour IA"
      },
      {
        "command": "codetourIA.cancelTourStepEditing",
        "title": "Cancel Step Editing",
        "category": "CodeTour IA"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "codetourIA.addContentStep",
          "when": "codetour:inTour && codetour:recording && codetour:canEditTour"
        },
        {
          "command": "codetourIA.endTour",
          "when": "codetour:inTour"
        },
        {
          "command": "codetourIA.recordTour",
          "when": "workspaceFolderCount != 0"
        },
        {
          "command": "codetourIA.resetProgress",
          "when": "codetour:hasProgress"
        },
        {
          "command": "codetourIA.resumeTour",
          "when": "codetour:inTour"
        },
        {
          "command": "codetourIA.startTour",
          "when": "codetour:hasTours"
        },
        {
          "command": "codetourIA.addDirectoryStep",
          "when": "false"
        },
        {
          "command": "codetourIA.addSelectionStep",
          "when": "false"
        },
        {
          "command": "codetourIA.addTourStep",
          "when": "false"
        },
        {
          "command": "codetourIA.changeTourRef",
          "when": "false"
        },
        {
          "command": "codetourIA.changeTourStepLine",
          "when": "false"
        },
        {
          "command": "codetourIA.changeTourStepTitle",
          "when": "false"
        },
        {
          "command": "codetourIA.changeTourStepIcon",
          "when": "false"
        },
        {
          "command": "codetourIA.changeTourTitle",
          "when": "false"
        },
        {
          "command": "codetourIA.changeTourDescription",
          "when": "false"
        },
        {
          "command": "codetourIA.deleteTour",
          "when": "false"
        },
        {
          "command": "codetourIA.deleteTourStep",
          "when": "false"
        },
        {
          "command": "codetourIA.editTour",
          "when": "false"
        },
        {
          "command": "codetourIA.editTourAtStep",
          "when": "false"
        },
        {
          "command": "codetourIA.exportTour",
          "when": "false"
        },
        {
          "command": "codetourIA.hideMarkers",
          "when": "false"
        },
        {
          "command": "codetourIA.makeTourPrimary",
          "when": "false"
        },
        {
          "command": "codetourIA.nextTourStep",
          "when": "false"
        },
        {
          "command": "codetourIA.previewTour",
          "when": "false"
        },
        {
          "command": "codetourIA.previousTourStep",
          "when": "false"
        },
        {
          "command": "codetourIA.resetTourProgress",
          "when": "false"
        },
        {
          "command": "codetourIA.saveTourStep",
          "when": "codetour:isEditing && !codetour:recording && codetour:canEditTour"
        },
        {
          "command": "codetourIA.showMarkers",
          "when": "false"
        },
        {
          "command": "codetourIA.showStepDescription",
          "when": "codetour:inTour && !codetour:recording"
        },
        {
          "command": "codetourIA.unmakeTourPrimary",
          "when": "false"
        },
        {
          "command": "codetourIA.viewNotebook",
          "when": "false"
        },
        {
          "command": "codetourIA.cancelTourStepEditing",
          "when": "codetour:isEditing && !codetour:recording && codetour:canEditTour"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "codetourIA.showStepDescription",
          "group": "inline@0",
          "when": "commentController == codetour"
        },
        {
          "command": "codetourIA.previousTourStep",
          "group": "inline@1",
          "when": "commentController == codetour && commentThread =~ /hasPrevious/"
        },
        {
          "command": "codetourIA.nextTourStep",
          "group": "inline@2",
          "when": "commentController == codetour && commentThread =~ /hasNext/"
        },
        {
          "command": "codetourIA.endTour",
          "group": "inline@3",
          "when": "commentController == codetour"
        },
        {
          "command": "codetourIA.editTour",
          "group": "inline@4",
          "when": "commentController == codetour && !codetour:isEditing && codetour:canEditTour"
        },
        {
          "command": "codetourIA.previewTour",
          "group": "inline@4",
          "when": "commentController == codetour && codetour:isEditing && !commentThreadIsEmpty"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "codetourIA.addTourStep",
          "group": "inline",
          "when": "commentController == codetour && commentThreadIsEmpty"
        }
      ],
      "comments/comment/title": [
        {
          "command": "codetourIA.moveTourStepBack",
          "group": "move@1",
          "when": "commentController == codetour && codetour:canEditTour && commentThread =~ /hasPrevious/"
        },
        {
          "command": "codetourIA.moveTourStepForward",
          "group": "move@2",
          "when": "commentController == codetour && codetour:canEditTour && commentThread =~ /hasNext/"
        },
        {
          "command": "codetourIA.changeTourStepLine",
          "group": "mutate@1",
          "when": "commentController == codetour && codetour:canEditTour"
        },
        {
          "command": "codetourIA.deleteTourStep",
          "group": "mutate@2",
          "when": "commentController == codetour && codetour:canEditTour"
        }
      ],
      "comments/comment/context": [
        {
          "command": "codetourIA.saveTourStep",
          "group": "inline@2",
          "when": "commentController == codetour && codetour:recording"
        }
      ],
      "view/title": [
        {
          "command": "codetourIA.hideMarkers",
          "when": "view == codetour.tours && codetour:showingMarkers",
          "group": "navigation@1"
        },
        {
          "command": "codetourIA.showMarkers",
          "when": "view == codetour.tours && !codetour:showingMarkers",
          "group": "navigation@1"
        },
        {
          "command": "codetourIA.openTourFile",
          "when": "view == codetour.tours",
          "group": "navigation@2"
        },
        {
          "command": "codetourIA.recordTour",
          "when": "view == codetour.tours",
          "group": "navigation@3"
        },
        {
          "command": "codetourIA.showStepDescription",
          "when": "view == codetour.tours && codetour:inTour && !codetour:recording",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "codetourIA.endTour",
          "when": "viewItem =~ /^codetour.tour(.recording)?.active/",
          "group": "inline@1"
        },
        {
          "command": "codetourIA.startTour",
          "when": "viewItem =~ /^codetour.tour(.primary)?$/",
          "group": "inline@1"
        },
        {
          "command": "codetourIA.resumeTour",
          "when": "viewItem =~ /^codetour.tour(.primary)?(.recording)?.active$/",
          "group": "active@1"
        },
        {
          "command": "codetourIA.endTour",
          "when": "viewItem =~ /^codetour.tour(.primary)?(.recording)?.active$/",
          "group": "active@2"
        },
        {
          "command": "codetourIA.startTour",
          "when": "viewItem =~ /^codetour.tour(.primary)?$/",
          "group": "basic@1"
        },
        {
          "command": "codetourIA.viewNotebook",
          "when": "false",
          "group": "basic@2"
        },
        {
          "command": "codetourIA.addContentStep",
          "when": "viewItem =~ /^codetour.tour(.primary)?.recording/",
          "group": "basic@1"
        },
        {
          "command": "codetourIA.resetTourProgress",
          "when": "false",
          "group": "basic@2"
        },
        {
          "command": "codetourIA.changeTourTitle",
          "when": "viewItem =~ /^codetour.tour(.primary)?(.recording)?(.active)?$/",
          "group": "change@1"
        },
        {
          "command": "codetourIA.changeTourDescription",
          "when": "viewItem =~ /^codetour.tour(.primary)?(.recording)?(.active)?$/",
          "group": "change@2"
        },
        {
          "command": "codetourIA.changeTourRef",
          "when": "viewItem =~ /^codetour.tour(.primary)?(.recording)?(.active)?$/ && gitOpenRepositoryCount != 0",
          "group": "change@3"
        },
        {
          "command": "codetourIA.makeTourPrimary",
          "when": "viewItem =~ /^codetour.tour(.recording)?(.active)?$/",
          "group": "edit@1"
        },
        {
          "command": "codetourIA.unmakeTourPrimary",
          "when": "viewItem =~ /^codetour.tour.primary(.recording)?(.active)?$/",
          "group": "edit@2"
        },
        {
          "command": "codetourIA.editTour",
          "when": "viewItem =~ /^codetour.tour(.primary)?(.active)?$/",
          "group": "edit@2"
        },
        {
          "command": "codetourIA.previewTour",
          "when": "viewItem =~ /^codetour.tour(.primary)?.recording/",
          "group": "edit@2"
        },
        {
          "command": "codetourIA.deleteTour",
          "when": "viewItem =~ /^codetour.tour(.primary)?(.recording)?(.active)?$/",
          "group": "edit@3"
        },
        {
          "command": "codetourIA.exportTour",
          "when": "viewItem =~ /^codetour.tour(.primary)?(.active)?$/",
          "group": "export@1"
        },
        {
          "command": "codetourIA.moveTourStepBack",
          "when": "viewItem =~ /^codetour.tourStep.hasPrevious/",
          "group": "inline@1"
        },
        {
          "command": "codetourIA.moveTourStepForward",
          "when": "viewItem =~ /codetour.tourStep.*(.hasNext)/",
          "group": "inline@2"
        },
        {
          "command": "codetourIA.moveTourStepBack",
          "when": "viewItem =~ /^codetour.tourStep.hasPrevious/",
          "group": "basic@1"
        },
        {
          "command": "codetourIA.moveTourStepForward",
          "when": "viewItem =~ /codetour.tourStep.*(.hasNext)/",
          "group": "basic@2"
        },
        {
          "command": "codetourIA.changeTourStepTitle",
          "when": "viewItem =~ /^codetour.tourStep/",
          "group": "change@1"
        },
        {
          "command": "codetourIA.changeTourStepIcon",
          "when": "viewItem =~ /^codetour.tourStep/",
          "group": "change@2"
        },
        {
          "command": "codetourIA.addContentStep",
          "when": "viewItem =~ /^codetour.tourStep/ && codetour:recording",
          "group": "change@2"
        },
        {
          "command": "codetourIA.editTourAtStep",
          "when": "viewItem =~ /^codetour.tourStep/ && !codetour:recording",
          "group": "manage@1"
        },
        {
          "command": "codetourIA.deleteTourStep",
          "when": "viewItem =~ /^codetour.tourStep/",
          "group": "manage@2"
        }
      ],
      "explorer/context": [
        {
          "command": "codetourIA.addDirectoryStep",
          "when": "codetour:recording && explorerResourceIsFolder"
        }
      ],
      "editor/context": [
        {
          "command": "codetourIA.addSelectionStep",
          "when": "codetour:recording && editorHasSelection",
          "group": "codetour@1"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "codetour.tours",
          "name": "CodeTour",
          "when": "workspaceFolderCount != 0 || codetour:inTour"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codetour.tours",
        "contents": "In order to create a guided walkthrough, you can begin recording a tour for the currently opened workspace ([Learn More](https://github.com/vsls-contrib/codetour#recording-tours)).\n\n[Record Tour](command:codetourIA.recordTour)\n\nYou can also open tours that were shared with you by others ([Learn More](https://github.com/vsls-contrib/codetour#opening-tours)).\n\n[Open Tour File](command:codetourIA.openTourFile)\n\n[Open Tour URL](command:codetourIA.openTourUrl)"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "*.tour",
        "url": "./schema.json"
      }
    ],
    "keybindings": [
      {
        "command": "codetourIA.previousTourStep",
        "when": "codetour:inTour && !textInputFocus && !terminalFocus",
        "key": "ctrl+left",
        "mac": "cmd+left"
      },
      {
        "command": "codetourIA.nextTourStep",
        "when": "codetour:inTour && !textInputFocus && !terminalFocus",
        "key": "ctrl+right",
        "mac": "cmd+right"
      },
      {
        "command": "codetourIA.endTour",
        "when": "codetour:inTour && !textInputFocus && !terminalFocus",
        "key": "ctrl+down ctrl+down",
        "mac": "cmd+down cmd+down"
      },
      {
        "command": "codetourIA.startTour",
        "when": "!textInputFocus && !terminalFocus",
        "key": "ctrl+up ctrl+up",
        "mac": "cmd+up cmd+up"
      }
    ],
    "languages": [
      {
        "id": "json",
        "extensions": [
          ".tour"
        ]
      }
    ],
    "notebookProvider": [
      {
        "viewType": "codetour",
        "displayName": "CodeTour IA",
        "selector": [
          {
            "filenamePattern": "*.tour-notebook"
          }
        ]
      }
    ]
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.8.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/jexl": "^2.2.0",
    "axios": "^0.21.4",
    "jexl": "^2.3.0",
    "markdown-it": "^12.3.2",
    "mobx": "^5.14.2",
    "sanitize-html": "^2.13.1",
    "throttle-debounce": "^3.0.1",
    "vsls": "^1.0.2532",
    "@b9g/termdom": "0.2.4"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^18.14.0",
    "@types/sanitize-html": "^2.11.0",
    "@types/throttle-debounce": "^5.0.0",
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "^2.17.0",
    "codetour-description-renderer": "file:packages/description-renderer",
    "debug": "^4.3.4",
    "eslint": "^8.34.0",
    "ts-loader": "^9.4.2",
    "typescript": "^5.9.3",
    "vscode-jsonrpc": "8.2.0",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1",
    "webpack-merge": "^5.8.0"
  },
  "scripts": {
    "build": "npm --prefix packages/description-renderer run build && npm --prefix packages/mcp-server run build && webpack --mode production && node scripts/prepare-resvg-runtime.js",
    "watch": "webpack --mode development --watch",
    "package": "node scripts/package-extension.js",
    "vscode:prepublish": "npm run build",
    "test": "npm run build && node scripts/sync-renderer-dep.js && tsc -p tsconfig.test.json && node scripts/run-compiled-tests.js dist/test && npm --prefix packages/description-renderer test && npm --prefix packages/mcp-server test && node --test test/copilot-adapter.test.mjs",
    "cli": "node dist/cli.js",
    "package:standalone": "node scripts/package-standalone.js",
    "test:standalone": "node --test test/standalone-package.test.js"
  },
  "prettier": {
    "arrowParens": "avoid",
    "trailingComma": "none"
  },
  "bin": {
    "codetour": "./dist/cli.js"
  }
}
