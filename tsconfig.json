{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2019",
    "outDir": "out",
    "lib": ["ES2019", "DOM"],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "baseUrl": ".",
    "paths": {
      "codetour-description-renderer": [
        "packages/description-renderer/dist/src/index"
      ],
      "codetour-mcp": [
        "packages/mcp-server/dist/src/cli"
      ]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
